# ResuAlign-Agent Configuration

# --- LLM Provider ---
# Supported: deepseek, gemini, glm, moonshot, openrouter, openai, anthropic, ollama, mock
LLM_PROVIDER=deepseek

# OpenAI-compatible providers (set prefix matching the provider name)
# For DEEPSEEK:    DEEPSEEK_API_KEY, DEEPSEEK_MODEL=deepseek-chat
# For GLM (Zhipu): GLM_API_KEY, GLM_MODEL=glm-4
# For MOONSHOT:    MOONSHOT_API_KEY, MOONSHOT_MODEL=moonshot-v1-8k
# For OPENROUTER:  OPENROUTER_API_KEY, OPENROUTER_MODEL=openai/gpt-4o
# For OPENAI:      OPENAI_API_KEY, OPENAI_MODEL=gpt-4o
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-chat

# Gemini (native SDK, not OpenAI-compatible)
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.0-flash

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Ollama (local, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Mock (demo mode, no LLM at all)
MOCK_DELAY_MS=500

# --- Database ---
DATABASE_URL=postgresql+asyncpg://resualign:resualign@localhost:5432/resualign
POSTGRES_USER=resualign
POSTGRES_PASSWORD=resualign
POSTGRES_DB=resualign

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Server ---
HOST=0.0.0.0
PORT=8000
ENV=development

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=30

# --- Cache ---
CACHE_TTL_HOURS=24

# --- PDF ---
OCR_FALLBACK_ENABLED=false
OCR_LANGUAGE=chi_sim+eng
